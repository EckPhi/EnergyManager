# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://energy:energy@localhost:5432/energy_scheduler

# ── Application ───────────────────────────────────────────────────────────────
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
DEBUG=false
LOG_LEVEL=INFO

# ── Timezone ──────────────────────────────────────────────────────────────────
# IANA timezone name used for schedule display and DST handling
TIMEZONE=Europe/Vienna

# ── Scheduler Defaults ────────────────────────────────────────────────────────
SCHEDULER_GRID_MINUTES=15

# ── Pricing Providers ─────────────────────────────────────────────────────────
# Active provider: nordpool | awattar
PRICE_PROVIDER=awattar

# Nord Pool
NORDPOOL_REGION=AT
# NORDPOOL_API_KEY=

# aWATTar
AWATTAR_COUNTRY=at
# AWATTAR_API_KEY=

# ── Home Assistant Connector ──────────────────────────────────────────────────
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=your-long-lived-access-token
